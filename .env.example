# Optional single-backend override; leave unset to load saved named backends.
# T3_HTTP_URL=http://127.0.0.1:3773
# T3_BEARER_TOKEN_FILE=/custom/path/to/token
# Optional override; otherwise T3 Code's advertised environment label is used.
# WATCHER_NAME=My T3 server
WATCHER_POLL_MS=2000
WATCHER_AUTO_SETTLE_DAYS=3
WATCHER_HOST=127.0.0.1
PORT=4173
# Optional browser URL used when a thread row is clicked.
# T3_WEB_URL=https://app.t3.codes
